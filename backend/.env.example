# ==============================================================================
# HL² Backend Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH REAL PRODUCTION CREDENTIALS
# DO NOT COMMIT SENSITIVE SECRETS TO VERSION CONTROL
# ==============================================================================

# Server Environment
PORT=5001
NODE_ENV=production

# Database (MongoDB Connection String with replica set and TLS)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/hl2_prod?retryWrites=true&w=majority

# CORS Allowed Origins (Comma-separated in production or exact mobile scheme/domain)
CORS_ORIGIN=https://hl2.app,https://admin.hl2.app

# Authentication & Security
# Generate a cryptographically random 64-character secret using: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Redis & BullMQ Queue Infrastructure
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_redis_auth_password_if_configured
QUEUE_CONCURRENCY=5
QUEUE_RATE_LIMIT_MAX=10

# Push Notification Service Provider
# Options: 'expo' | 'mock' | 'custom'
NOTIFICATION_PROVIDER=expo
EXPO_ACCESS_TOKEN=replace_with_expo_push_access_token

# Affiliate & Buy Now Monetization Configuration
AFFILIATE_ENABLED=true
AFFILIATE_AMAZON_TAG=hl2app-21
AFFILIATE_FLIPKART_AFFID=hl2app
AFFILIATE_CROMA_TAG=hl2_partner
APP_CAMPAIGN_SOURCE=hl2_mobile_production

# Logging & Observability
LOG_LEVEL=info
SENTRY_DSN=https://<public_key>@sentry.io/<project_id>
