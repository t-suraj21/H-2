# =================================================================
# HL² Backend Server Environment Configuration
# =================================================================

PORT=5001
NODE_ENV=development

# Database Connection (TLS / Replica set for production)
MONGO_URI=mongodb://localhost:27017/hl2

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_32_characters_minimum
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Redis & BullMQ Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional CORS & Affiliate Partner Configuration
CORS_ORIGIN=http://localhost:5001,http://localhost:19006
AFFILIATE_ENABLED=true
AFFILIATE_AMAZON_TAG=your_amazon_affiliate_tag
AFFILIATE_FLIPKART_AFFID=your_flipkart_affiliate_id
AFFILIATE_CROMA_TAG=your_croma_affiliate_tag
