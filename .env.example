# =================================================================
# HL² Mobile App Client-side Configuration (Expo / React Native)
# =================================================================

# Backend API Endpoint
EXPO_PUBLIC_API_URL=http://localhost:5001/api

# Google OAuth Web Client ID
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Auth0 Client-Side Configuration (Public IDs only - NEVER put client secrets here)
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your_auth0_client_id
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.hl2.app
